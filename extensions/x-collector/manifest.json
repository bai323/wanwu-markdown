{
  "manifest_version": 3,
  "name": "Everything Markdown X Collector",
  "version": "0.1.0",
  "description": "Collect visible X likes/bookmarks into Everything Markdown.",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "http://localhost:4173/*"],
  "action": {
    "default_popup": "popup.html"
  }
}
